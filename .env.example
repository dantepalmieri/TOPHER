ANTHROPIC_API_KEY=your-api-key-here
OBSIDIAN_VAULT_PATH=C:/Users/you/Documents/YourVaultName

# optional: huggingface token, picked up implicitly by sentence-transformers/huggingface_hub
# for downloading the embedding model - not read directly by this project's own code
HF_TOKEN=

# optional: bind the dashboard server to a specific address instead of localhost-only,
# e.g. your Tailscale IP (find it with `tailscale ip -4`), so it's reachable from
# other devices on your private network - see README's "Remote access" section
# before setting this, since it removes the localhost-only boundary entirely
DASHBOARD_SERVER_HOST=
